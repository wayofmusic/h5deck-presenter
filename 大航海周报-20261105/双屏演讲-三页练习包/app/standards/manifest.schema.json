{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H5 Presenter content package v1",
  "type": "object", "additionalProperties": false,
  "required": ["packageFormat","schemaVersion","deckId","revision","title","entry","adapter","notes","capabilities","chapters","speaker","slides"],
  "properties": {
    "packageFormat": {"const":"h5-presenter-content/1"},
    "schemaVersion": {"const":1},
    "deckId": {"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
    "revision": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "title": {"type":"string","minLength":1,"maxLength":200},
    "entry": {"type":"string","minLength":1,"maxLength":180},
    "notes": {"type":"string","minLength":1,"maxLength":180},
    "adapter": {"type":"object","additionalProperties":false,"required":["protocol","path"],"properties":{"protocol":{"const":"h5-presenter-bridge/1"},"path":{"type":"string","minLength":1,"maxLength":180}}},
    "capabilities": {"type":"object","additionalProperties":false,"required":["navigation","reveal","widgetSnapshot"],"properties":{"navigation":{"const":true},"reveal":{"type":"boolean"},"widgetSnapshot":{"type":"boolean"}}},
    "speaker": {"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":100}}},
    "chapters": {"type":"array","minItems":1,"maxItems":100,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string","maxLength":200}}},
    "slides": {"type":"array","minItems":1,"maxItems":2000,"items":{"type":"object","additionalProperties":false,"required":["id","chapter","title","steps","seconds"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},"chapter":{"type":"integer","minimum":0},"title":{"type":"string","minLength":1,"maxLength":200},"steps":{"type":"integer","minimum":1,"maximum":100},"seconds":{"type":"integer","minimum":0,"maximum":86400}}}},
    "widgets": {"type":"object","maxProperties":32,"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},"additionalProperties":{"type":"object","additionalProperties":false,"required":["type","initial"],"properties":{"type":{"enum":["integer","number","boolean","string"]},"initial":{"type":["number","boolean","string"]},"min":{"type":"number"},"max":{"type":"number"},"maxLength":{"type":"integer","minimum":1,"maximum":2000},"enum":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":["number","boolean","string"]}}}}}
  }
}
